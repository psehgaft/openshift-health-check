<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>OpenShift ATP Execution Report — {{ cluster_name | e }}</title>
  <style>
    :root { color-scheme: light; --border: #222; --label: #ededed; --pass: #e5f4e8; --fail: #fde8e7; --skip: #fff4d6; }
    body { margin: 0; padding: 24px; color: #171717; background: #f7f7f7; font: 15px/1.5 Arial, Helvetica, sans-serif; }
    main { max-width: 1100px; margin: auto; }
    h1 { margin: 0 0 6px; font-size: 25px; }
    .subtitle { color: #555; margin: 0 0 22px; }
    .summary { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 24px; }
    .summary span { background: white; border: 1px solid #bbb; border-radius: 4px; padding: 8px 12px; }
    article { background: #fff; border: 1px solid var(--border); margin: 18px 0; break-inside: avoid; }
    article h2 { margin: 0; padding: 10px 12px; background: #f2f2f2; border-bottom: 1px solid var(--border); font-size: 17px; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    th, td { border-bottom: 1px solid #777; padding: 9px 10px; vertical-align: middle; text-align: left; overflow-wrap: anywhere; }
    tr:last-child th, tr:last-child td { border-bottom: 0; }
    th { width: 28%; background: var(--label); font-weight: 700; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #f1f1f1; border: 1px solid #aaa; padding: 10px; margin: 8px 0; font: 13px/1.45 ui-monospace, SFMono-Regular, Consolas, monospace; }
    .pass { background: var(--pass); } .fail { background: var(--fail); } .skipped { background: var(--skip); }
    .checks { display: flex; gap: 18px; align-items: center; }
    input { width: 16px; height: 16px; vertical-align: middle; }
    .comment { color: #7a211d; }
    @media print { body { background: #fff; padding: 0; } article { margin: 12px 0; } }
  </style>
</head>
<body>
<main>
  <h1>Acceptance Test Procedure (ATP) — Execution Report</h1>
  <p class="subtitle">Red Hat OpenShift Container Platform {{ expected_ocp_version | default('4.20') | e }} · {{ cluster_name | e }} · {{ cluster_domain | e }}</p>
  <div class="summary">
    <span><strong>Date:</strong> {{ atp_start_time[0:10] | e }}</span>
    <span><strong>Started:</strong> {{ atp_start_time | e }}</span>
    <span><strong>Completed:</strong> {{ atp_end_time | default('N/A') | e }}</span>
    <span><strong>Cases:</strong> {{ atp_results | length }}</span>
    <span><strong>Pass:</strong> {{ atp_results | selectattr('status', 'equalto', 'Pass') | list | length }}</span>
    <span><strong>Fail:</strong> {{ atp_results | selectattr('status', 'equalto', 'Fail') | list | length }}</span>
    <span><strong>Skipped:</strong> {{ atp_results | selectattr('status', 'equalto', 'Skipped') | list | length }}</span>
  </div>
  {% for tc in atp_results %}
  <article>
    <h2>{{ tc.id | e }} — {{ tc.name | e }}</h2>
    <table>
      <tr><th>Date</th><td>{{ atp_start_time[0:10] | e }}</td></tr>
      <tr><th>Time</th><td>{{ atp_start_time[11:19] | e }} UTC</td></tr>
      <tr><th>Description</th><td>{{ tc.name | e }}</td></tr>
      <tr><th>Topology</th><td>Red Hat OpenShift Container Platform {{ expected_ocp_version | default('4.20') | e }} ({{ cluster_name | e }}.{{ cluster_domain | e }})</td></tr>
      <tr><th>Procedure</th><td><p>Run from an authenticated bastion session. Review the test definition before enabling any gated or disruptive case.</p><pre>{{ tc.procedure | default('See ATP task implementation') | e }}</pre></td></tr>
      <tr><th>Expected result</th><td>{{ tc.expected | e }}<p><strong>Observed result and command evidence</strong></p><pre>{{ tc.evidence | default(tc.details | default('No command output captured')) | e }}</pre></td></tr>
      <tr class="{{ tc.status | lower | e }}"><th>Conclusion</th><td><div class="checks"><label><input type="checkbox" disabled {% if tc.status == 'Pass' %}checked{% endif %}> Pass</label><label><input type="checkbox" disabled {% if tc.status == 'Fail' %}checked{% endif %}> Fail</label><label><input type="checkbox" disabled {% if tc.status == 'Skipped' %}checked{% endif %}> Skipped</label></div><strong>{{ tc.status | e }}</strong></td></tr>
      <tr><th>Additional comments</th><td>{% if tc.status == 'Fail' %}
        {% set cat = tc.category | default('') %}
        {% if 'Network' in cat or 'Networking' in cat %}<span class="comment">Check the affected Network/Route/Multus resource, CNO conditions, DNS resolution, node connectivity, and relevant events. Correct the failed network prerequisite and rerun.</span>
        {% elif 'Storage' in cat or 'Backup' in cat %}<span class="comment">Inspect StorageClass and CSI health, PVC/PV events and binding, capacity, and the backup or snapshot procedure. Resolve the storage-side cause before rerunning.</span>
        {% elif 'Security' in cat or 'User' in cat %}<span class="comment">Verify identity provider configuration, user/group mapping, RBAC bindings, certificate validity, and least-privilege access. Correct the failing security control and rerun.</span>
        {% elif 'Application' in cat or 'Workload' in cat %}<span class="comment">Inspect workload events, scheduling constraints, quotas, labels, affinity, and pod readiness. Correct the workload configuration and rerun.</span>
        {% else %}<span class="comment">Review captured output; verify cluster access, RBAC, dependencies, and the affected component conditions. Correct the underlying cause and rerun this ATP case.</span>{% endif %}
      {% elif tc.status == 'Skipped' %}Not executed. Review operational impact and prerequisites before enabling this gated test.
      {% else %}No corrective action required based on this ATP result.{% endif %}</td></tr>
    </table>
  </article>
  {% endfor %}
</main>
</body>
</html>
