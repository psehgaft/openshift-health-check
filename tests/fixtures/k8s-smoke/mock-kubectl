#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

join_args() {
  local IFS=' '
  printf '%s' "$*"
}

cmd="$(join_args "$@")"

case "${cmd}" in
  "auth whoami")
    printf 'fixture-user\n'
    ;;
  "config current-context")
    printf 'fixture-k8s-context\n'
    ;;
  "config view --minify -o jsonpath={.clusters[0].cluster.server}")
    printf 'https://fixture-k8s-api.example.test\n'
    ;;
  "api-resources -o wide")
    cat "${ROOT_DIR}/api-resources.txt"
    ;;
  "get nodes -o json")
    cat "${ROOT_DIR}/nodes.json"
    ;;
  "get pods -A -o json")
    cat "${ROOT_DIR}/pods.json"
    ;;
  "get deployments -A -o json")
    cat "${ROOT_DIR}/deployments.json"
    ;;
  "get statefulsets -A -o json")
    cat "${ROOT_DIR}/statefulsets.json"
    ;;
  "get daemonsets -A -o json")
    cat "${ROOT_DIR}/daemonsets.json"
    ;;
  "get poddisruptionbudgets.policy -A -o json")
    cat "${ROOT_DIR}/poddisruptionbudgets.json"
    ;;
  "get ingresses.networking.k8s.io -A -o json")
    cat "${ROOT_DIR}/ingresses.json"
    ;;
  "get serviceaccounts -A -o json")
    cat "${ROOT_DIR}/serviceaccounts.json"
    ;;
  "get rolebindings.rbac.authorization.k8s.io -A -o json")
    cat "${ROOT_DIR}/rolebindings.json"
    ;;
  "get clusterrolebindings.rbac.authorization.k8s.io -o json")
    cat "${ROOT_DIR}/clusterrolebindings.json"
    ;;
  "get services -A -o json")
    cat "${ROOT_DIR}/services.json"
    ;;
  "get endpoints -A -o json")
    cat "${ROOT_DIR}/endpoints.json"
    ;;
  "get crd -o json")
    cat "${ROOT_DIR}/crds.json"
    ;;
  "get namespaces -o json")
    cat "${ROOT_DIR}/namespaces.json"
    ;;
  "get networkpolicies -A -o json")
    cat "${ROOT_DIR}/networkpolicies.json"
    ;;
  "get resourcequotas -A -o json")
    cat "${ROOT_DIR}/resourcequotas.json"
    ;;
  "get limitranges -A -o json")
    cat "${ROOT_DIR}/limitranges.json"
    ;;
  "get secrets -A -o json")
    cat "${ROOT_DIR}/secrets.json"
    ;;
  "get configmaps -A -o json")
    cat "${ROOT_DIR}/configmaps.json"
    ;;
  "get storageclass -o json")
    cat "${ROOT_DIR}/storageclasses.json"
    ;;
  "get pv -o json")
    cat "${ROOT_DIR}/persistentvolumes.json"
    ;;
  "get pvc -A -o json")
    cat "${ROOT_DIR}/persistentvolumeclaims.json"
    ;;
  "get events -A --field-selector type=Warning -o json")
    cat "${ROOT_DIR}/warning_events.json"
    ;;
  "get horizontalpodautoscalers.autoscaling -A -o json")
    cat "${ROOT_DIR}/horizontalpodautoscalers.json"
    ;;
  "get servicemonitors.monitoring.coreos.com -A -o json --ignore-not-found")
    cat "${ROOT_DIR}/servicemonitors.json"
    ;;
  "get podmonitors.monitoring.coreos.com -A -o json --ignore-not-found")
    cat "${ROOT_DIR}/podmonitors.json"
    ;;
  *)
    printf 'unsupported fixture command: %s\n' "${cmd}" >&2
    exit 1
    ;;
esac
