{% macro status_badge(value) -%}
{%- set text = value | string -%}
{%- set key = text | trim | upper -%}
{%- if key in ['UNKONWN', 'UNKNWON', 'UNKNONW'] -%}
{%- set key = 'UNKNOWN' -%}
{%- set text = 'not-assessed' -%}
{%- elif key == 'UNKNOWN' -%}
{%- set text = 'not-assessed' -%}
{%- endif -%}
{%- if key in ['CRITICAL', 'FAILED', 'FAIL', 'ERROR', 'DEGRADED', 'UNSUPPORTED-RISK'] -%}
<span class="status-critical">{{ text }}</span>
{%- elif key in ['WARNING', 'WARN', 'LOW', 'POOR', 'REVIEW-REQUIRED'] -%}
<span class="status-warn">{{ text }}</span>
{%- elif key in ['HEALTHY', 'OK', 'PASS', 'PASSED', 'TRUE', 'ALIGNED', 'EXCELLENT', 'GOOD', 'HIGH', 'SUPPORTED', 'BASIC-SUPPORTED', 'COMPLETED', 'PRESENT'] -%}
<span class="status-ok">{{ text }}</span>
{%- elif key in ['INFO', 'FAIR', 'MEDIUM', 'PARTIAL', 'NODE-LEVEL-NOT-REQUESTED', 'NODE-LEVEL-NO-TARGETS', 'PLANNED', 'NOT-RUN', 'NOT-REQUESTED'] -%}
<span class="status-info">{{ text }}</span>
{%- elif key in ['UNKNOWN', 'UNAVAILABLE', 'N/A', 'NONE', 'NOT-COLLECTED', 'INSUFFICIENT-EVIDENCE'] -%}
<span class="status-unknown">{{ text }}</span>
{%- else -%}
{{ text }}
{%- endif -%}
{%- endmacro %}

{% macro posture_score(status) -%}
{%- set key = (status | default('unknown') | string | trim | upper) -%}
{%- if key in ['UNKONWN', 'UNKNWON', 'UNKNONW'] -%}
{%- set key = 'UNKNOWN' -%}
{%- endif -%}
{%- if key in ['CRITICAL', 'BLOCKED', 'UNSUPPORTED-RISK'] -%}
25/100
{%- elif key in ['WARNING', 'WARN', 'REVIEW-REQUIRED'] -%}
60/100
{%- elif key in ['INFO', 'PARTIAL'] -%}
80/100
{%- elif key in ['HEALTHY', 'READY', 'SUPPORTED', 'OK'] -%}
100/100
{%- else -%}
not-scored
{%- endif -%}
{%- endmacro %}

