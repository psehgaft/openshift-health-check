{
  "apiVersion": "apps/v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "db",
        "namespace": "app-team-a"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {"app": "db"}
        },
        "serviceName": "db",
        "template": {
          "metadata": {
            "labels": {"app": "db"}
          },
          "spec": {
            "containers": [
              {
                "name": "db",
                "image": "postgres:16",
                "resources": {
                  "requests": {"cpu": "200m", "memory": "512Mi"},
                  "limits": {"cpu": "1", "memory": "1Gi"}
                },
                "readinessProbe": {
                  "tcpSocket": {"port": 5432}
                },
                "livenessProbe": {
                  "tcpSocket": {"port": 5432}
                }
              }
            ]
          }
        }
      },
      "status": {
        "replicas": 1,
        "readyReplicas": 1,
        "updatedReplicas": 1
      }
    }
  ]
}
