# Replace these RFC 5737 documentation addresses with node IP addresses.
[masters]
master0 ansible_host=192.0.2.10
master1 ansible_host=192.0.2.11
master2 ansible_host=192.0.2.12

[workers]
worker0 ansible_host=192.0.2.20
worker1 ansible_host=192.0.2.21

[all:vars]
ansible_user=core
ansible_ssh_private_key_file=~/.ssh/id_rsa
